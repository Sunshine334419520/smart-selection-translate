{
  "name": "dsh-smart-selection-translate",
  "version": "0.1.0",
  "description": "选中英文就地翻译的 DeepSeek Harness 插件：单词出词典条目（音标、词性释义、网络释义、真人发音），句子走机器翻译。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "translation",
    "dictionary",
    "word-selection",
    "划词翻译"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sunshine334419520/smart-selection-translate.git"
  },
  "homepage": "https://github.com/Sunshine334419520/smart-selection-translate",
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
